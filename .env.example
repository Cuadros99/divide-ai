APP_USER=admin
APP_PASSWORD=changeme
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# DATABASE_URL local dev (default, sem config extra):
DATABASE_URL=sqlite:///./data/listadivide.db

# DATABASE_URL pra Turso (produção): só o host, sem token embutido.
# DATABASE_URL=sqlite+libsql://<db-name>-<org>.turso.io
# TURSO_AUTH_TOKEN=<token de `turso db tokens create`>

STORAGE_BACKEND=local
GCS_BUCKET_NAME=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  # só pra testar GCS localmente; não precisa no Cloud Run

# Integração com o Tricount (API não-oficial). TRICOUNT_ENABLED é o kill switch;
# TRICOUNT_PROVIDER escolhe entre o backend fake (dev) e o real.
TRICOUNT_ENABLED=false
TRICOUNT_PROVIDER=fake
# TRICOUNT_TOKEN é o tXXXXX do link tricount.com/tXXXXX. É SEGREDO: dá leitura
# E escrita no grupo e não é revogável (se vazar, só resta recriar o tricount).
TRICOUNT_TOKEN=
# JSON das credenciais do device (Credentials.generate/save): só app_id + chave pública,
# então NÃO é segredo por conteúdo. Persistir é operacional (credencial estável = join uma
# vez só, sem device novo por cold start); fica no Secret Manager por disciplina/formato.
TRICOUNT_CREDENTIALS_JSON=
TRICOUNT_TIMEOUT_SECONDS=8.0
